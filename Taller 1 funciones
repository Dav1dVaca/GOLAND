package main

import "fmt"

func main() {

	for {
		var opcion string

		fmt.Println(" MENU ")
		fmt.Println("1. Promedio de notas")
		fmt.Println("2. Suma de 1 a n")
		fmt.Println("3. Celsius a Fahrenheit")
		fmt.Println("4. Fahrenheit a Celsius")
		fmt.Println("0. Salir")
		fmt.Println("También puede escribir 'salir'")
		fmt.Print("Elija una opción: ")

		fmt.Scan(&opcion)

		if opcion == "0" || opcion == "salir" {
			fmt.Println("Salio del programa.")
			break
		}

		switch opcion {
		case "1":
			opcionnotas()
		case "2":
			opcionsuma()
		case "3":
			opcioncelsius()
		case "4":
			opcionfahrenheit()
		default:
			fmt.Println("Opción inválida.")
		}
	}
}

/* Función para calcular promedio */
func averageGrade(suma float64, cantidad int) float64 {
	return suma / float64(cantidad)
}

/* Opcion 1 */
func opcionnotas() {
	var cantidad int

	fmt.Println("Ingrese la cantidad de estudiantes: ")
	fmt.Scan(&cantidad)

	var suma float64

	for i := 1; i <= cantidad; i++ {
		var nota float64

		fmt.Printf("Ingrese la nota del estudiante %d: ", i)
		fmt.Scan(&nota)

		suma += nota
	}

	promedio := averageGrade(suma, cantidad)

	fmt.Printf("Promedio del curso: %.2f\n", promedio)

	if promedio >= 70 {
		fmt.Println("Curso APROBADO")
	} else {
		fmt.Println("Curso REPROBADO")
	}

	switch {
	case promedio >= 90 && promedio <= 100:
		fmt.Println("Excellent performance")
	case promedio >= 80:
		fmt.Println("Good performance")
	case promedio >= 70:
		fmt.Println("Satisfactory performance")
	default:
		fmt.Println("Needs improvement")
	}
}

/* opcion 2 */

func opcionsuma() {
	var n int

	fmt.Print("Ingrese un número: ")
	fmt.Scan(&n)

	suma := 0

	for i := 1; i <= n; i++ {
		suma += i
	}

	fmt.Printf("La suma de 1 a %d es: %d\n", n, suma)
}

/* opcion 3 */

func opcioncelsius() {
	var celsius float64

	fmt.Print("Ingrese temperatura en Celsius: ")
	fmt.Scan(&celsius)

	fahrenheit := (celsius * 9 / 5) + 32

	fmt.Printf("%.2f °C = %.2f °F\n", celsius, fahrenheit)
}

/* opcion 4 */

func opcionfahrenheit() {
	var fahrenheit float64

	fmt.Print("Ingrese temperatura en Fahrenheit: ")
	fmt.Scan(&fahrenheit)

	celsius := (fahrenheit - 32) * 5 / 9

	fmt.Printf("%.2f = %.2f \n", fahrenheit, celsius)
}
